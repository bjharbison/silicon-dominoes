[Unit]
Description=Silicon Dominoes — RSS feed poller
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=dominoes
WorkingDirectory=/opt/silicon-dominoes/collection
EnvironmentFile=/etc/silicon-dominoes/collector.env
ExecStart=/opt/silicon-dominoes/collection/.venv/bin/python -m collector.poll_rss
